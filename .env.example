# PayPal sandbox app — create at https://developer.paypal.com/dashboard/applications/sandbox
# "Create App" -> copy Client ID / Secret below. Do NOT use a live app.
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_SECRET=your-sandbox-secret
PAYPAL_ENV=sandbox

# LLM gateway (OpenRouter). Free model; swap OPENROUTER_MODEL if it stops responding
# (free tiers rotate — check https://openrouter.ai/models for a working :free model).
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# OPTIONAL: require a shared secret on every mutating API call (POST/PUT/DELETE).
# When set, requests must send `x-agentguard-token: <same value>`. The demo UI
# does NOT send it — only enable this for scripted/LAN use.
# AGENTGUARD_TOKEN=

# OPTIONAL: override the data directory (ledger + mandate). Defaults to
# <project root>/data — only needed when launching `next start` by hand from a
# different cwd (npm run dev/start always run from the project root).
# AGENTGUARD_DATA_DIR=
