  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "24.9.2",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.3"
